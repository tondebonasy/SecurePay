{
  "expo": {
    "name": "SecurePay",
    "slug": "securepay",
    "scheme": "securepay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SecurePay to scan payment request QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.moneyguard.app"
    },
    "android": {
      "package": "com.moneyguard.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {}
    }
  }
}

